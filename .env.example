# Application environment. Copy to .env.local; do not commit .env.local.
NODE_ENV=development

# Local service ports
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
LITELLM_PORT=4000
OLLAMA_PORT=11434

# Non-secret local defaults
POSTGRES_DB=aacc
POSTGRES_USER=aacc
OLLAMA_MODEL=qwen2.5:3b
LITELLM_BASE_URL=http://localhost:4000
OLLAMA_BASE_URL=http://localhost:11434

# Set real secret values only in .env.local or an approved secret store.
# POSTGRES_PASSWORD=
# SESSION_SECRET=
# LITELLM_MASTER_KEY=
